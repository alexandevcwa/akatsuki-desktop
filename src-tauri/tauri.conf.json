{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Akatsuki Desktop",
  "version": "0.1.0",
  "identifier": "com.akatsuki.cyberlink.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Akatsuki // Shinobi Secure File Transfer",
        "width": 1340,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#07070C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Akatsuki Project",
    "category": "Utility",
    "shortDescription": "Cliente de transferencia segura de archivos PC <-> Android sobre LAN HTTPS",
    "longDescription": "Cliente de escritorio multiplataforma de alto rendimiento para transferencia bidireccional de archivos por streaming HTTPS con dispositivos Android en red local y verificacion de integridad SHA-256 extremo a extremo.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/windows/nsis-header.bmp",
        "sidebarImage": "icons/windows/nsis-sidebar.bmp"
      },
      "wix": {
        "language": "es-ES"
      }
    }
  }
}
