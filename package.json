{
  "name": "akatsuki-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Akatsuki Cyberpunk Desktop Client for Secure Android File Transfer (Tauri v2)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:manjaro": "tauri build --no-bundle",
    "install:manjaro": "bash ./scripts/install-manjaro.sh",
    "icon:manjaro": "bash ./scripts/install-manjaro.sh --icon-only",
    "build:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/build-windows.ps1 -Target all",
    "build:windows:nsis": "powershell -ExecutionPolicy Bypass -File ./scripts/build-windows.ps1 -Target nsis",
    "build:windows:msi": "powershell -ExecutionPolicy Bypass -File ./scripts/build-windows.ps1 -Target msi",
    "build:windows:cross": "bash ./scripts/build-windows-from-linux.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-store": "^2.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
